    "# To check the entered value is odd or Even\n",
    "num1 = int(input(\"Enter the number:\"))\n",
    "ans=(num1%2)\n",
    "if(ans==0):\n",
    "    print(\"Even Number\")\n",
    "else:\n",
    "    print(\"Odd Number\")\n",
    "    \n"
